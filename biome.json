{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"attributePosition": "auto",
		"bracketSpacing": true,
		"expand": "auto"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"indentStyle": "tab",
			"indentWidth": 2
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
            "groups": [
              // ===== npm packages =====
              { "type": false, "source": ":PACKAGE:" },
              ":BLANK_LINE:",

              // ===== user modules =====
              { "type": false, "source": ":PATH:" },
              ":BLANK_LINE:",

              // ===== import types =====
              { "type": true }
            ]
          }
				}
			}
		}
	}
}
